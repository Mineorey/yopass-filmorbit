# FilmOrbit Safe – Konfiguration
# Kopieren nach .env (cp .env.example .env) und ACCESS_PASSWORD eintragen.
# Die .env enthält das Zugangspasswort: nie ins Git-Repository einchecken.

# Gemeinsames Zugangspasswort, das Kunden zum Erstellen eines Geheimnisses
# eingeben. Lang und zufällig wählen. Leer = kein Passwortschutz (nicht verwenden!).
ACCESS_PASSWORD=

# Öffentliche Adresse; macht die Links korrekt und das Zugangs-Cookie "Secure".
PUBLIC_URL=https://safe.filmorbit.de

# Adresse von Caddy, damit jeder Kunde sein eigenes Rate-Limit bekommt.
# Variante A (Caddy direkt auf dem Server): 127.0.0.1
# Variante B (Caddy in Docker): Subnetz des Caddy-Netzes, z. B. 172.18.0.0/16
TRUSTED_PROXIES=127.0.0.1

# Nur für Variante B: Name des Docker-Netzes von Caddy.
# CADDY_NETWORK=caddy

# Geheimnisse werden nach dem ersten Öffnen gelöscht (so steht es in der FAQ).
FORCE_ONETIME_SECRETS=true
MAX_FILE_SIZE=1MB
NO_LANGUAGE_SWITCHER=true
NO_THEME_SWITCHER=true
IMPRINT_URL=https://filmorbit.de/impressum/
PRIVACY_NOTICE_URL=https://filmorbit.de/datenschutz/
